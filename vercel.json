{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install --include-workspace-root --workspace=@naejip/web",
  "buildCommand": "npm run build:web",
  "outputDirectory": "apps/web/dist",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "naejip-budget.vercel.app" }],
      "destination": "https://naejip-budget.site/$1",
      "permanent": true
    }
  ]
}
